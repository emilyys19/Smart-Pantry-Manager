<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartpantrymanager"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.smartpantrymanager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.smartpantrymanager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager" >

        <!-- Main host with Bottom Navigation -->
        <activity
            android:name="com.smartpantrymanager.MainActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.smartpantrymanager.PantryListActivity"
            android:label="My Pantry"
            android:parentActivityName="com.smartpantrymanager.MainActivity" />
        <activity
            android:name="com.smartpantrymanager.AddEditIngredientActivity"
            android:label="Add Ingredient"
            android:parentActivityName="com.smartpantrymanager.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.smartpantrymanager.SuggestedRecipesActivity"
            android:label="Suggested Recipes"
            android:parentActivityName="com.smartpantrymanager.MainActivity" />
        <activity
            android:name="com.smartpantrymanager.RecipeDetailActivity"
            android:label="Recipe Detail"
            android:parentActivityName="com.smartpantrymanager.SuggestedRecipesActivity" />
        <activity
            android:name="com.smartpantrymanager.SettingsActivity"
            android:label="Settings"
            android:parentActivityName="com.smartpantrymanager.MainActivity" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.smartpantrymanager.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>